# GSC Opportunity MCP — copy to .env and fill in. Never commit .env.

# The Search Console property to analyze. REQUIRED.
# Domain property form ("sc-domain:example.com") is preferred: it covers every
# subdomain and http/https variant.
CREATOR_SEO_SITE=

# Days per analysis window (complete days; Search Console lags ~1-2 days).
CREATOR_SEO_DAYS=28

# Display-ad revenue per 1000 pageviews. ESTIMATE used only for ranking.
# Set this to your real RPM once you have one; the ranking scales with it.
CREATOR_SEO_SITE_RPM=5

# Extra affiliate revenue per 1000 clicks, keyed by query/page substring.
# Example: {"smart-ring": 40} => "smart ring" queries score an extra $40/1k clicks.
CREATOR_SEO_AFFILIATE_CATEGORIES={}

# --- Optional: Raptive Creator API (real per-page RPM) -----------------------
# Mint in the Raptive dashboard -> Account Settings -> Raptive Creator API.
# Eligibility: Insider / Platinum / Platinum Elite / Luminary tiers.
# Leave blank and the server falls back to CREATOR_SEO_SITE_RPM.
RAPTIVE_CLIENT_ID=
RAPTIVE_CLIENT_SECRET=
